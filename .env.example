# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 절대 공유·업로드하지 마세요)

# 공공데이터포털 > 행정안전부_대한민국 공공서비스(혜택) 정보 > 활용신청 후 받은 "일반 인증키(Decoding)"
DATA_GO_KR_KEY=

# Anthropic 콘솔(console.anthropic.com)에서 발급한 API 키
ANTHROPIC_API_KEY=

# 요약 모델 (기본: claude-opus-5-5). 비용을 줄이려면 claude-sonnet-5-5 또는 claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# 한 번 실행에 Claude로 처리할 최대 건수 (0 = 제한 없음). 첫 실행 때 50 정도로 품질부터 확인 권장
ENRICH_LIMIT=50
ENRICH_CONCURRENCY=4

# 배포할 도메인 (sitemap·canonical에 사용)
SITE_URL=https://example.com
SITE_NAME=지원금 레이더

# 애드센스 승인 후 ca-pub-XXXXXXXX 입력 (비우면 광고 코드 없음)
ADSENSE_CLIENT=
